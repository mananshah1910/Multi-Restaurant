{
	"info": {
		"_postman_id": "cravedash-microservices-collection-v1",
		"name": "CraveDash Microservices Suite (PS034)",
		"description": "Complete Postman Collection for CraveDash Multi-Restaurant Food Ordering & Delivery Orchestration Engine routed through API Gateway (http://localhost:8080).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "restaurantId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "itemId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "orderId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "paymentId",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"postman_customer\",\n  \"password\": \"Password123!\",\n  \"role\": \"CUSTOMER\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						},
						"description": "Register a new user account (Public Endpoint)."
					}
				},
				{
					"name": "Login User & Save Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('jwt_token', jsonData.token);",
									"    console.log('JWT Token saved automatically to collection variable jwt_token');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"postman_customer\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						},
						"description": "Log in and automatically extract & store JWT token into collection variables."
					}
				}
			]
		},
		{
			"name": "2. Restaurant & Menu Management",
			"item": [
				{
					"name": "Create Restaurant",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Gourmet Pasta & Pizza\",\n  \"address\": \"45 Park Avenue\",\n  \"phone\": \"555-8888\",\n  \"status\": \"ACTIVE\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/restaurants",
							"host": ["{{baseUrl}}"],
							"path": ["restaurants"]
						}
					}
				},
				{
					"name": "Get All Restaurants",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/restaurants",
							"host": ["{{baseUrl}}"],
							"path": ["restaurants"]
						}
					}
				},
				{
					"name": "Get Restaurant by ID",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/restaurants/{{restaurantId}}",
							"host": ["{{baseUrl}}"],
							"path": ["restaurants", "{{restaurantId}}"]
						}
					}
				},
				{
					"name": "Update Restaurant",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Gourmet Pasta & Pizza Deluxe\",\n  \"phone\": \"555-9999\",\n  \"status\": \"ACTIVE\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/restaurants/{{restaurantId}}",
							"host": ["{{baseUrl}}"],
							"path": ["restaurants", "{{restaurantId}}"]
						}
					}
				},
				{
					"name": "Add Menu Item 1",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Truffle Pasta\",\n  \"description\": \"Delicious cream pasta\",\n  \"price\": 450.0,\n  \"availability\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/restaurants/{{restaurantId}}/menu",
							"host": ["{{baseUrl}}"],
							"path": ["restaurants", "{{restaurantId}}", "menu"]
						}
					}
				},
				{
					"name": "Add Menu Item 2",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Garlic Bread\",\n  \"description\": \"Toasted with butter & herbs\",\n  \"price\": 150.0,\n  \"availability\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/restaurants/{{restaurantId}}/menu",
							"host": ["{{baseUrl}}"],
							"path": ["restaurants", "{{restaurantId}}", "menu"]
						}
					}
				},
				{
					"name": "Get Restaurant Menu",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/restaurants/{{restaurantId}}/menu",
							"host": ["{{baseUrl}}"],
							"path": ["restaurants", "{{restaurantId}}", "menu"]
						}
					}
				},
				{
					"name": "Update Real-Time Item Availability",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"url": {
							"raw": "{{baseUrl}}/restaurants/{{restaurantId}}/menu/{{itemId}}/availability?available=true",
							"host": ["{{baseUrl}}"],
							"path": ["restaurants", "{{restaurantId}}", "menu", "{{itemId}}", "availability"],
							"query": [
								{
									"key": "available",
									"value": "true"
								}
							]
						}
					}
				}
			]
		},
		{
			"name": "3. Multi-Item Order Orchestration",
			"item": [
				{
					"name": "Create Multi-Item Order",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"restaurantId\": 1,\n  \"customerId\": 101,\n  \"items\": [\n    {\n      \"menuItemId\": 1,\n      \"quantity\": 2\n    },\n    {\n      \"menuItemId\": 2,\n      \"quantity\": 1\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/orders",
							"host": ["{{baseUrl}}"],
							"path": ["orders"]
						}
					}
				},
				{
					"name": "Get All Orders",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/orders",
							"host": ["{{baseUrl}}"],
							"path": ["orders"]
						}
					}
				},
				{
					"name": "Get Order by ID",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/orders/{{orderId}}",
							"host": ["{{baseUrl}}"],
							"path": ["orders", "{{orderId}}"]
						}
					}
				},
				{
					"name": "Track Order Status",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/orders/{{orderId}}/status",
							"host": ["{{baseUrl}}"],
							"path": ["orders", "{{orderId}}", "status"]
						}
					}
				},
				{
					"name": "Update Order Status",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"PREPARING\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/orders/{{orderId}}",
							"host": ["{{baseUrl}}"],
							"path": ["orders", "{{orderId}}"]
						}
					}
				}
			]
		},
		{
			"name": "4. Payment Processing",
			"item": [
				{
					"name": "Get All Payments",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/payments",
							"host": ["{{baseUrl}}"],
							"path": ["payments"]
						}
					}
				},
				{
					"name": "Get Payment by ID",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/payments/{{paymentId}}",
							"host": ["{{baseUrl}}"],
							"path": ["payments", "{{paymentId}}"]
						}
					}
				},
				{
					"name": "Update Payment Status to PAID",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"url": {
							"raw": "{{baseUrl}}/payments/{{paymentId}}/status?status=PAID",
							"host": ["{{baseUrl}}"],
							"path": ["payments", "{{paymentId}}", "status"],
							"query": [
								{
									"key": "status",
									"value": "PAID"
								}
							]
						}
					}
				}
			]
		},
		{
			"name": "5. Service Discovery & Health",
			"item": [
				{
					"name": "Eureka Dashboard Applications",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "http://localhost:8761/eureka/apps",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8761",
							"path": ["eureka", "apps"]
						}
					}
				},
				{
					"name": "API Gateway Health Check",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/actuator/health",
							"host": ["{{baseUrl}}"],
							"path": ["actuator", "health"]
						}
					}
				}
			]
		}
	]
}
